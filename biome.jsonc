{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/worker-configuration.d.ts",
			"!apps/www/src/routeTree.gen.ts"
		]
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"yaml": {
		"formatter": {
			"enabled": false
		}
	},
	"assist": {
		"actions": {
			"source": {
				"useSortedAttributes": "off"
			}
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"useSemanticElements": "off",
				"useMediaCaption": "off",
				"noSvgWithoutTitle": "off",
				"noStaticElementInteractions": "off",
				"noNoninteractiveElementInteractions": "off",
				"useKeyWithClickEvents": "off"
			},
			"style": {
				"useBlockStatements": "off",
				"noNestedTernary": "off",
				"noNonNullAssertion": "off",
				"noMagicNumbers": "off"
			},
			"nursery": {
				"useTailwindSortedClasses": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"noUnknownAtRules": "off",
				"useAwait": "off",
				"noConsole": "off",
				"noExplicitAny": "off",
				"noEmptyBlockStatements": "off",
				"noShadow": "off",
				"noUnnecessaryConditions": "off"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off",
				"useSimplifiedLogicExpression": "off",
				"noBannedTypes": "off",
				"noForEach": "off"
			},
			"performance": {
				"noNamespaceImport": "off",
				"noImgElement": "off",
				"noBarrelFile": "off"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
